# ========================================
# MCP Servers — Environment Variables
# Copy to .env and fill in your values
# ========================================

# --- MoySklad (ERP/Inventory) ---
# Auth: Bearer token OR Basic login/password
MOYSKLAD_TOKEN=
MOYSKLAD_LOGIN=
MOYSKLAD_PASSWORD=

# --- CDEK (Delivery) ---
# Auth: OAuth2 client credentials
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_SANDBOX=false

# --- CBR (Central Bank of Russia) ---
# No auth required

# --- CBU (Central Bank of Uzbekistan) ---
# No auth required

# --- Bitrix24 (CRM) ---
# Auth: Webhook URL (includes auth in path)
BITRIX24_WEBHOOK_URL=

# --- CloudPayments (Payments) ---
# Auth: Basic (public_id:api_secret)
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=

# --- GetCourse (EdTech/LMS) ---
# Auth: API key as query param
GETCOURSE_DOMAIN=
GETCOURSE_API_KEY=

# --- Payme (Uzbekistan Payments) ---
# Auth: X-Auth header
PAYME_CASHBOX_ID=
PAYME_KEY=
PAYME_SANDBOX=true

# --- Robokassa (Payments) ---
# Auth: MD5 signature
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST=false

# --- T-Kassa / Tinkoff (Payments) ---
# Auth: SHA-256 token
TKASSA_TERMINAL_KEY=
TKASSA_PASSWORD=

# --- Travelpayouts (Flights) ---
# Auth: Token as query param
TRAVELPAYOUTS_TOKEN=
