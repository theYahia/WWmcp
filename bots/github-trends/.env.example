# Telegram bot — получить токен у @BotFather, chat_id у @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Obsidian vault root — куда писать Inbox карточки
OBSIDIAN_VAULT_PATH=D:/Yahia/obsidian/Base

# Минимальный score (число matched keywords) для алерта
MIN_SCORE=3

# Trending окно: daily | weekly | monthly
TRENDING_SINCE=daily

# Сколько верхних repos парсить
TOP_N=25

# Dry-run флаг (true = не отправлять TG, не писать Obsidian, только лог)
DRY_RUN=false
