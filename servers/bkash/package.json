{
  "name": "@theyahia/bkash-mcp",
  "version": "1.1.0",
  "description": "bKash mobile money for AI agents: tokenized checkout payments, execute and query, refunds, recurring agreements, transaction search (8 tools, Bangladesh)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bkash-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "smithery.yaml"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/bkash-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "bkash",
    "বিকাশ",
    "bangladesh",
    "bangladesh-api",
    "mobile-money",
    "payments",
    "checkout",
    "refunds",
    "fintech",
    "emerging-markets"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/WWmcp.git",
    "directory": "servers/bkash"
  },
  "homepage": "https://github.com/theYahia/WWmcp/tree/main/servers/bkash",
  "author": "theYahia (https://github.com/theYahia)"
}
