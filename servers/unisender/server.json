{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.theYahia/unisender-mcp",
  "title": "UniSender",
  "description": "UniSender - email campaigns, contact lists, subscriptions, templates, stats (Russia)",
  "websiteUrl": "https://github.com/theYahia/WWmcp/tree/main/servers/unisender",
  "repository": {
    "url": "https://github.com/theYahia/WWmcp",
    "source": "github",
    "subfolder": "servers/unisender"
  },
  "version": "1.1.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@theyahia/unisender-mcp",
      "version": "1.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "UNISENDER_API_KEY",
          "description": "API key from the UniSender account settings",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
