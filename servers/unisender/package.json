{
  "name": "@theyahia/unisender-mcp",
  "version": "1.1.1",
  "description": "UniSender for AI agents: create and send email campaigns, manage contact lists and subscriptions, templates, delivery statistics (10 tools, Russia)",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "unisender-mcp": "dist/index.js" },
  "files": ["dist", "smithery.yaml", "skills"],
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": { "access": "public" },
  "mcpName": "io.github.theYahia/unisender-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "unisender",
    "юнисендер",
    "email",
    "рассылка",
    "email-marketing",
    "newsletter",
    "campaigns",
    "mailing",
    "templates",
    "subscribers",
    "russia",
    "russian-api"
  ],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/theYahia/WWmcp.git", "directory": "servers/unisender" },
  "author": "theYahia (https://github.com/theYahia)"
}
