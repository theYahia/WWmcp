{
  "name": "@theyahia/cbu-mcp",
  "version": "1.1.1",
  "description": "Central Bank of Uzbekistan rates for AI agents: ~30 currencies against UZS, historical rates, daily dynamics, cross-rate conversion (5 tools, Uzbekistan)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cbu-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/cbu-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "cbu",
    "uzbekistan",
    "узбекистан",
    "central-bank",
    "currency",
    "exchange-rate",
    "курс-валют",
    "uzs",
    "sum",
    "сум",
    "emerging-markets"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/WWmcp.git",
    "directory": "servers/cbu"
  },
  "author": "theYahia (https://github.com/theYahia)"
}
