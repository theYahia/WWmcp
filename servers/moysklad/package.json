{
  "name": "@theyahia/moysklad-mcp",
  "version": "3.1.1",
  "description": "MoySklad (МойСклад) for AI agents: stock and warehouse moves, inventory counts, product search by SKU, price updates, customer and purchase orders, supplies, shipments, payments and invoices, profit and turnover reports (60 tools, Russia)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "moysklad-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/moysklad-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "moysklad",
    "мойсклад",
    "moy-sklad",
    "erp",
    "inventory",
    "warehouse",
    "склад",
    "товароучет",
    "stock",
    "остатки",
    "orders",
    "supplies",
    "shipments",
    "invoices",
    "payments",
    "webhooks",
    "russia",
    "russian-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/WWmcp.git",
    "directory": "servers/moysklad"
  },
  "author": "theYahia (https://github.com/theYahia)"
}
