{
  "name": "@theyahia/moysklad-mcp",
  "version": "2.1.0",
  "description": "MCP server for MoySklad (Moy Sklad) ERP/inventory API — products, stock, orders, counterparties, supplies, profit reports. 10 tools. Token bucket rate limiting (45 req/3s). Dual auth: Bearer token or Basic login/password.",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "moysklad-mcp": "dist/index.js" },
  "files": ["dist"],
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": { "access": "public" },
  "mcpName": "io.github.theYahia/moysklad-mcp",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "claude", "ai", "russian-api", "moysklad", "erp", "inventory", "warehouse", "orders"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/theYahia/mcp-servers.git", "directory": "servers/moysklad" },
  "author": "theYahia (https://github.com/theYahia)"
}
