{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.theYahia/vk-mcp",
  "title": "VK (VKontakte)",
  "description": "VKontakte - wall posts, publishing, messages, friends, users, groups, stats (Russia)",
  "websiteUrl": "https://github.com/theYahia/WWmcp/tree/main/servers/vk",
  "repository": {
    "url": "https://github.com/theYahia/WWmcp",
    "source": "github",
    "subfolder": "servers/vk"
  },
  "version": "1.1.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@theyahia/vk-mcp",
      "version": "1.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "VK_ACCESS_TOKEN",
          "description": "VK API access token (vk.com/dev)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
