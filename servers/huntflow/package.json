{
  "name": "@theyahia/huntflow-mcp",
  "version": "1.2.0",
  "description": "Huntflow ATS for AI agents: vacancy and applicant search, resumes, hiring stages, sources, rejection reasons, divisions and coworkers (14 tools, Russia)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "huntflow-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/huntflow-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "huntflow",
    "хантфлоу",
    "ats",
    "recruiting",
    "рекрутинг",
    "hr",
    "candidates",
    "кандидаты",
    "vacancies",
    "вакансии",
    "resume",
    "russia",
    "russian-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/huntflow-mcp.git"
  },
  "author": "theYahia (https://github.com/theYahia)"
}
