{
  "name": "@theyahia/calltouch-mcp",
  "version": "1.2.1",
  "description": "Calltouch call tracking for AI agents: calls and leads for a period, traffic sources, tags, campaign statistics (7 tools, Russia)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "calltouch-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "calltouch",
    "call-tracking",
    "коллтрекинг",
    "analytics",
    "аналитика",
    "marketing",
    "leads",
    "лиды",
    "attribution",
    "calls",
    "russia",
    "russian-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/calltouch-mcp.git"
  },
  "homepage": "https://github.com/theYahia/calltouch-mcp#readme",
  "author": "theYahia (https://github.com/theYahia)",
  "mcpName": "io.github.theYahia/calltouch-mcp"
}
