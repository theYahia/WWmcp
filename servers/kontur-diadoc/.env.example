# Diadoc API credentials. Copy to `.env` (gitignored) for local development,
# or set these as environment variables in your MCP client config.

# Developer key (a.k.a. ddauth_api_client_id) issued when you register for API access.
DIADOC_API_CLIENT_ID=

# Diadoc account login + password.
DIADOC_LOGIN=
DIADOC_PASSWORD=

# Optional: override the API host (e.g. a sandbox). Defaults to production.
# DIADOC_BASE_URL=https://diadoc-api.kontur.ru
