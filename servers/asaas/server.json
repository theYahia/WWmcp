{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.theYahia/asaas-mcp",
  "title": "Asaas",
  "description": "Asaas - payments, Pix QR, customers, subscriptions and refunds (Brazil)",
  "websiteUrl": "https://github.com/theYahia/WWmcp/tree/main/servers/asaas",
  "repository": {
    "url": "https://github.com/theYahia/WWmcp",
    "source": "github",
    "subfolder": "servers/asaas"
  },
  "version": "1.0.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@theyahia/asaas-mcp",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ASAAS_API_KEY",
          "description": "API key from the Asaas dashboard",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
