{
  "name": "@theyahia/orange-money-mcp",
  "version": "1.1.0",
  "description": "Orange Money WebPay for AI agents: web payments and status, cash-in and cash-out, transfers, webhook validation, balance across ~12 countries (8 tools, Africa)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "orange-money-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "smithery.yaml"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/orange-money-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "orange-money",
    "orange",
    "mobile-money",
    "paiement",
    "payments",
    "senegal",
    "ivory-coast",
    "cote-divoire",
    "cameroon",
    "mali",
    "africa",
    "africa-api",
    "francophone-africa",
    "emerging-markets"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/WWmcp.git",
    "directory": "servers/orange-money"
  },
  "homepage": "https://github.com/theYahia/WWmcp/tree/main/servers/orange-money",
  "author": "theYahia (https://github.com/theYahia)"
}
