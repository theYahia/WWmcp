{
  "name": "@theyahia/roistat-mcp",
  "version": "1.1.1",
  "description": "Roistat for AI agents: marketing analytics and ROI reports, leads, visits, ad channels, costs, integrations (6 tools, Russia)",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "roistat-mcp": "dist/index.js" },
  "files": ["dist"],
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": { "access": "public" },
  "mcpName": "io.github.theYahia/roistat-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "roistat",
    "роистат",
    "analytics",
    "аналитика",
    "marketing",
    "маркетинг",
    "roi",
    "сквозная-аналитика",
    "leads",
    "лиды",
    "attribution",
    "russia",
    "russian-api"
  ],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/theYahia/WWmcp.git", "directory": "servers/roistat" },
  "author": "theYahia (https://github.com/theYahia)"
}
