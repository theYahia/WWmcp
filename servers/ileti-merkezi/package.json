{
  "name": "@theyahia/ileti-merkezi-mcp",
  "version": "4.0.1",
  "description": "Ileti Merkezi (İletiMerkezi) SMS for AI agents: send SMS/OTP and bulk, cancel scheduled orders, delivery reports, sender headers, blacklist, İYS consent (11 tools, Turkey)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ileti-merkezi-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "smithery.yaml"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/ileti-merkezi-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "iletimerkezi",
    "ileti-merkezi",
    "turkey",
    "türkiye",
    "turkish-api",
    "sms",
    "toplu-sms",
    "bulk-sms",
    "otp",
    "messaging",
    "emerging-markets",
    "iys",
    "sms-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/WWmcp.git",
    "directory": "servers/ileti-merkezi"
  },
  "homepage": "https://github.com/theYahia/WWmcp/tree/main/servers/ileti-merkezi",
  "author": "theYahia (https://github.com/theYahia)"
}
