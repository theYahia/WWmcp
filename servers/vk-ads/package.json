{
  "name": "@theyahia/vk-ads-mcp",
  "version": "3.0.0",
  "description": "VK Ads for AI agents: create and update campaigns and ads, statistics, targeting groups, budgets (8 tools, Russia)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vk-ads-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "smithery.yaml"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
