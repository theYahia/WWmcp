{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.theYahia/salla-mcp",
  "title": "Salla",
  "description": "Salla store - product and category CRUD, stock, orders, customers, coupons (Saudi Arabia)",
  "websiteUrl": "https://github.com/theYahia/WWmcp/tree/main/servers/salla",
  "repository": {
    "url": "https://github.com/theYahia/WWmcp",
    "source": "github",
    "subfolder": "servers/salla"
  },
  "version": "3.1.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@theyahia/salla-mcp",
      "version": "3.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SALLA_ACCESS_TOKEN",
          "description": "OAuth 2.0 access token from salla.partners",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
