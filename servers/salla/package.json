{
  "name": "@theyahia/salla-mcp",
  "version": "3.1.1",
  "description": "Salla store for AI agents: product and category CRUD, bulk stock updates, orders and status changes, customers, coupons, abandoned carts (22 tools, Saudi Arabia)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "salla-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "smithery.yaml"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/salla-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "salla",
    "سلة",
    "saudi-arabia",
    "saudi-api",
    "gulf",
    "mena",
    "e-commerce",
    "ecommerce",
    "marketplace",
    "products",
    "orders",
    "seller-api",
    "arabic",
    "emerging-markets"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/WWmcp.git",
    "directory": "servers/salla"
  },
  "homepage": "https://github.com/theYahia/WWmcp/tree/main/servers/salla",
  "author": "theYahia (https://github.com/theYahia)"
}
