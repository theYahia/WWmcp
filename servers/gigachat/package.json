{
  "name": "@theyahia/gigachat-mcp",
  "version": "3.0.1",
  "description": "Sber GigaChat for AI agents: chat completions, text embeddings, image generation, token counting, model and assistant lists, file upload, balance (8 tools, Russia)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gigachat-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/gigachat-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "gigachat",
    "гигачат",
    "sber",
    "сбер",
    "sberbank",
    "chat-completion",
    "embeddings",
    "image-generation",
    "russian-llm",
    "russia",
    "russian-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/WWmcp.git",
    "directory": "servers/gigachat"
  },
  "homepage": "https://github.com/theYahia/WWmcp/tree/main/servers/gigachat",
  "author": "theYahia (https://github.com/theYahia)"
}
