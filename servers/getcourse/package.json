{
  "name": "@theyahia/getcourse-mcp",
  "version": "1.2.0",
  "description": "MCP server for GetCourse API — users, deals, create/update users. 3 tools. API key as query param.",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "getcourse-mcp": "dist/index.js" },
  "files": ["dist"],
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.11",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": { "access": "public" },
  "mcpName": "io.github.theYahia/getcourse-mcp",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "claude", "ai", "russian-api", "getcourse", "lms", "education", "deals"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/theYahia/mcp-servers.git", "directory": "servers/getcourse" },
  "author": "theYahia (https://github.com/theYahia)"
}
