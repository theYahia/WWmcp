{
  "name": "@theyahia/yandex-search-mcp",
  "version": "1.0.0",
  "description": "Yandex Wordstat for AI agents: top search requests, query dynamics over time, regional breakdown for Russian-market SEO (3 tools, Russia)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "yandex-search-mcp": "dist/index.js"
  },
  "files": ["dist", "smithery.yaml"],
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "publishConfig": { "access": "public" },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "wordstat",
    "вордстат",
    "yandex",
    "яндекс",
    "yandex-cloud",
    "keyword-research",
    "семантическое-ядро",
    "seo",
    "russian-seo",
    "search-volume",
    "частотность",
    "russia",
    "russian-api"
  ],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/theYahia/yandex-search-mcp.git" },
  "homepage": "https://github.com/theYahia/yandex-search-mcp#readme",
  "author": "theYahia (https://github.com/theYahia)",
  "mcpName": "io.github.theYahia/yandex-search-mcp"
}
