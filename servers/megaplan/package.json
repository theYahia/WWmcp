{
  "name": "@theyahia/megaplan-mcp",
  "version": "4.0.0",
  "description": "MCP server for Megaplan — tasks, deals, project management (Russia)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "megaplan-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "smithery.yaml"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:http": "node dist/index.js --http",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/megaplan-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai",
    "russian-api",
    "megaplan",
    "tasks",
    "deals",
    "project-management",
    "api",
    "typescript",
    "crm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/WWmcp.git",
    "directory": "servers/megaplan"
  },
  "homepage": "https://github.com/theYahia/WWmcp/tree/main/servers/megaplan",
  "author": "theYahia (https://github.com/theYahia)"
}
