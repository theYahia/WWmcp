{
  "name": "@theyahia/megaplan-mcp",
  "version": "3.0.0",
  "description": "Megaplan (Мегаплан) for AI agents: create and read tasks and deals, projects, employees, comments (8 tools + 2 prompts, Russia)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "megaplan-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "smithery.yaml"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/megaplan-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "megaplan",
    "мегаплан",
    "crm",
    "срм",
    "project-management",
    "управление-проектами",
    "tasks",
    "задачи",
    "deals",
    "сделки",
    "russia",
    "russian-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/WWmcp.git",
    "directory": "servers/megaplan"
  },
  "homepage": "https://github.com/theYahia/WWmcp/tree/main/servers/megaplan",
  "author": "theYahia (https://github.com/theYahia)"
}
