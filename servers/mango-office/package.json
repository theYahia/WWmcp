{
  "name": "@theyahia/mango-office-mcp",
  "version": "1.1.1",
  "description": "Mango Office cloud PBX for AI agents: call history and statistics, click-to-call, call recordings, SMS, extension users (8 tools, Russia)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mango-office-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/mango-office-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "mango-office",
    "mango",
    "манго-телеком",
    "telephony",
    "телефония",
    "pbx",
    "атс",
    "voip",
    "calls",
    "звонки",
    "sms",
    "call-recording",
    "russia",
    "russian-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/WWmcp.git",
    "directory": "servers/mango-office"
  },
  "homepage": "https://github.com/theYahia/WWmcp/tree/main/servers/mango-office",
  "author": "theYahia (https://github.com/theYahia)"
}
