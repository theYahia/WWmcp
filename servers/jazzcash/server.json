{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.theYahia/jazzcash-mcp",
  "title": "JazzCash",
  "description": "JazzCash - mobile wallet, mobile account, OTC vouchers, refunds (Pakistan)",
  "websiteUrl": "https://github.com/theYahia/WWmcp/tree/main/servers/jazzcash",
  "repository": {
    "url": "https://github.com/theYahia/WWmcp",
    "source": "github",
    "subfolder": "servers/jazzcash"
  },
  "version": "2.0.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@theyahia/jazzcash-mcp",
      "version": "2.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "JAZZCASH_MERCHANT_ID",
          "description": "Merchant ID from the JazzCash merchant portal",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "JAZZCASH_PASSWORD",
          "description": "Merchant password",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "JAZZCASH_INTEGRITY_SALT",
          "description": "HMAC integrity salt (shared secret)",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "JAZZCASH_ENV",
          "description": "sandbox (default) or production",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "JAZZCASH_BASE_URL",
          "description": "Full base URL override; takes precedence over JAZZCASH_ENV",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
