{
  "name": "@theyahia/parasut-mcp",
  "version": "2.0.0",
  "description": "MCP server for Parasut — accounting, invoicing, payments, e-fatura/e-arşiv (Turkey). OAuth 2.0 password grant.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "parasut-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/parasut-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai",
    "turkey-api",
    "parasut",
    "accounting",
    "invoicing",
    "typescript",
    "api",
    "e-invoicing",
    "e-fatura",
    "e-arsiv",
    "fatura",
    "turkey"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/WWmcp.git",
    "directory": "servers/parasut"
  },
  "author": "theYahia (https://github.com/theYahia)"
}
