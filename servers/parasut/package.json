{
  "name": "@theyahia/parasut-mcp",
  "version": "2.0.0",
  "description": "MCP server for Parasut — accounting, invoicing, payments, e-fatura/e-arşiv (Turkey). OAuth 2.0 password grant.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "parasut-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/parasut-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai",
    "turkey-api",
    "parasut",
    "accounting",
    "invoicing",
    "typescript",
    "api",
    "e-invoicing",
    "e-fatura",
    "e-arsiv",
    "fatura",
    "turkey"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/parasut-mcp.git"
  },
  "homepage": "https://github.com/theYahia/parasut-mcp#readme",
  "author": "theYahia (https://github.com/theYahia)"
}
