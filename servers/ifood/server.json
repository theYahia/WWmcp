{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.theYahia/ifood-mcp",
  "title": "iFood",
  "description": "MCP server for iFood — orders, store operations, and catalog management (Brazil).",
  "websiteUrl": "https://github.com/theYahia/WWmcp/tree/main/servers/ifood",
  "repository": {
    "url": "https://github.com/theYahia/WWmcp",
    "source": "github",
    "subfolder": "servers/ifood"
  },
  "version": "1.1.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@theyahia/ifood-mcp",
      "version": "1.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "IFOOD_CLIENT_ID",
          "description": "iFood OAuth client ID",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "IFOOD_CLIENT_SECRET",
          "description": "iFood OAuth client secret",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
