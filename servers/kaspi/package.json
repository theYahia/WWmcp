{
  "name": "@theyahia/kaspi-mcp",
  "version": "1.0.2",
  "description": "Kaspi.kz marketplace for AI agents: list seller orders with filters, order details, product catalog (3 tools, Kazakhstan)",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "kaspi-mcp": "dist/index.js" },
  "files": ["dist"],
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": { "access": "public" },
  "mcpName": "io.github.theYahia/kaspi-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "kaspi",
    "каспи",
    "kaspi-kz",
    "kazakhstan",
    "казахстан",
    "kazakhstan-api",
    "marketplace",
    "маркетплейс",
    "orders",
    "seller-api",
    "e-commerce",
    "emerging-markets"
  ],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/theYahia/WWmcp.git", "directory": "servers/kaspi" },
  "author": "theYahia (https://github.com/theYahia)"
}
