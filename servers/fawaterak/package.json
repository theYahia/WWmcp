{
  "name": "@theyahia/fawaterak-mcp",
  "version": "1.1.0",
  "description": "Fawaterak payments for AI agents: create invoice links, Fawry / card / wallet / Meeza payment methods, invoice status, refunds, balance (8 tools, Egypt)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fawaterak-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "smithery.yaml"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/fawaterak-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "fawaterak",
    "فواتيرك",
    "egypt",
    "egypt-api",
    "mena",
    "fawry",
    "payments",
    "invoices",
    "wallets",
    "meeza",
    "fintech",
    "emerging-markets"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/WWmcp.git",
    "directory": "servers/fawaterak"
  },
  "homepage": "https://github.com/theYahia/WWmcp/tree/main/servers/fawaterak",
  "author": "theYahia (https://github.com/theYahia)"
}
