{
  "name": "@theyahia/cloudpayments-mcp",
  "version": "1.2.0",
  "description": "CloudPayments acquiring for AI agents: charge a card cryptogram, two-stage auth and confirm, void a hold, find a transaction, full or partial refund (6 tools, Russia)",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "cloudpayments-mcp": "dist/index.js" },
  "files": ["dist"],
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": { "access": "public" },
  "mcpName": "io.github.theYahia/cloudpayments-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "cloudpayments",
    "payments",
    "платежи",
    "acquiring",
    "эквайринг",
    "refunds",
    "возврат",
    "card-payments",
    "russia",
    "russian-api"
  ],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/theYahia/WWmcp.git", "directory": "servers/cloudpayments" },
  "author": "theYahia (https://github.com/theYahia)"
}
