{
  "name": "@theyahia/kontur-focus-mcp",
  "version": "3.0.1",
  "description": "Kontur.Focus (Контур.Фокус) for AI agents: company lookup by INN or OGRN, EGRUL details, financial statements, arbitration, bankruptcy, licenses (8 tools, Russia)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "kontur-focus-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/kontur-focus-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "kontur",
    "контур",
    "kontur-focus",
    "контур-фокус",
    "inn",
    "инн",
    "ogrn",
    "egrul",
    "егрюл",
    "counterparty",
    "контрагент",
    "due-diligence",
    "russia",
    "russian-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/WWmcp.git",
    "directory": "servers/kontur-focus"
  },
  "author": "theYahia (https://github.com/theYahia)"
}
