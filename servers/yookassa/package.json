{
  "name": "@theyahia/yookassa-mcp",
  "version": "3.0.0",
  "description": "YooKassa (ЮKassa) for AI agents: create and capture payments, refunds, 54-FZ receipts, payouts, SBP, recurring and split payments, webhooks (20 tools, Russia)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "yookassa-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/yookassa-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "yookassa",
    "юкасса",
    "yoomoney",
    "payments",
    "платежи",
    "acquiring",
    "эквайринг",
    "refunds",
    "receipts",
    "54-fz",
    "sbp",
    "сбп",
    "russia",
    "russian-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/WWmcp.git",
    "directory": "servers/yookassa"
  },
  "author": "theYahia (https://github.com/theYahia)"
}
