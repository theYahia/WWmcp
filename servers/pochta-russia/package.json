{
  "name": "@theyahia/pochta-russia-mcp",
  "version": "2.0.0",
  "description": "Russian Post (Почта России) for AI agents: parcel tracking, shipping tariffs, delivery time, post office lookup, zip codes, address normalization (6 tools, Russia)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pochta-russia-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "smithery.yaml"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/pochta-russia-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "llm",
    "pochta",
    "почта-россии",
    "russian-post",
    "pochta-ru",
    "tracking",
    "отслеживание",
    "трек-номер",
    "delivery",
    "доставка",
    "shipping",
    "postal",
    "индекс",
    "russia",
    "russian-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/WWmcp.git",
    "directory": "servers/pochta-russia"
  },
  "homepage": "https://github.com/theYahia/WWmcp/tree/main/servers/pochta-russia",
  "author": "theYahia (https://github.com/theYahia)"
}
