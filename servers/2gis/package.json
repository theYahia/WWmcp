{
  "name": "@theyahia/2gis-mcp",
  "version": "3.0.0",
  "description": "MCP server for 2GIS API — 8 tools: places search, geocoding, directions, reviews. Russia/CIS.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "2gis-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "smithery.yaml"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@theyahia/mcp-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/2gis-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai",
    "russian-api",
    "2gis",
    "geocoding",
    "places",
    "directions",
    "reviews",
    "maps"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/mcp-servers.git",
    "directory": "servers/2gis"
  },
  "homepage": "https://github.com/theYahia/mcp-servers/tree/main/servers/2gis",
  "author": "theYahia (https://github.com/theYahia)"
}
